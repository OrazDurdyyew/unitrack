# Переменные окружения для docker compose. Скопировать в infra/.env (он в .gitignore).

# Пароль пользователя PostgreSQL `unitrack`. Сгенерировать: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Порт, на котором nginx отдаёт веб-панель и проксирует /api наружу
UNITRACK_HTTP_PORT=8080

# Уровень логов API: debug | info | warn | error
UNITRACK_LOG_LEVEL=info

# Окружение: development | production
UNITRACK_ENV=production

# Версия сборки, попадает в /api/v1/health. При выпуске — тег git.
UNITRACK_VERSION=dev
