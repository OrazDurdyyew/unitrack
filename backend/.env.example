# Переменные для локальной разработки бэкенда. Скопировать в backend/.env (он в .gitignore).

# Сервер PostgreSQL для тестов с правом CREATE DATABASE. Если не задан — тесты поднимают
# контейнер postgres:17-alpine через testcontainers (нужен Docker и доступ к Docker Hub).
# Локальная установка:
#   sudo -u postgres psql -c "CREATE ROLE unitrack_test LOGIN CREATEDB PASSWORD 'unitrack_test';" \
#                        -c "CREATE DATABASE unitrack_test OWNER unitrack_test;"
TESTDB_URL=postgres://unitrack_test:unitrack_test@127.0.0.1:5432/unitrack_test?sslmode=disable

# Для `task backend:dev`
UNITRACK_DATABASE_URL=postgres://unitrack:unitrack@127.0.0.1:5432/unitrack?sslmode=disable
UNITRACK_HTTP_ADDR=:8080
UNITRACK_LOG_LEVEL=debug
UNITRACK_ENV=development
